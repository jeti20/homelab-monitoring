#!/usr/bin/env bash
#
# Simulates a script with 3 possible outcomes and writes metrics to a .prom file.
# Run repeatedly to observe changes in Grafana.
#
# Usage:
#   simulate.sh           <- random outcome
#   simulate.sh success   <- force success
#   simulate.sh no_result <- force no result
#   simulate.sh error     <- force error

TEXTFILE_DIR="{{ simulate_textfiles_dir }}"
METRICS_FILE="$TEXTFILE_DIR/my_script.prom"
TEMP_FILE="${METRICS_FILE}.tmp"

mkdir -p "$TEXTFILE_DIR"

# ─── Simulated script logic ───────────────────────────────────────────────────

forced="${1:-}"

if [[ -n "$forced" ]]; then
    outcome="$forced"
else
    # Random: 60% success, 20% no_result, 20% error
    roll=$((RANDOM % 10))
    if   (( roll < 6 )); then outcome="success"
    elif (( roll < 8 )); then outcome="no_result"
    else                       outcome="error"
    fi
fi

echo "[simulate.sh] Outcome: $outcome"

case "$outcome" in
    success)
        exit_status=0
        ;;
    no_result)
        exit_status=1
        ;;
    error)
        exit_status=2
        ;;
    *)
        echo "Unknown outcome: $outcome" >&2
        exit 1
        ;;
esac

# ─── Write metrics (atomic: write to tmp then mv) ────────────────────────────

timestamp=$(date +%s)

cat > "$TEMP_FILE" <<EOF
# HELP my_script_last_exit_status Last run outcome: 0=success 1=no_result 2=error
# TYPE my_script_last_exit_status gauge
my_script_last_exit_status $exit_status

# HELP my_script_last_run_timestamp_seconds Unix timestamp of the last run
# TYPE my_script_last_run_timestamp_seconds gauge
my_script_last_run_timestamp_seconds $timestamp
EOF

mv "$TEMP_FILE" "$METRICS_FILE"

echo "[simulate.sh] Metrics written to $METRICS_FILE"
